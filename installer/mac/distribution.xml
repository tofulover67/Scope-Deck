<?xml version="1.0" encoding="utf-8"?>
<!-- productbuild's distribution definition for ScopeDeck-<version>.pkg. The
     version and the component package name are filled in by release_mac.sh. -->
<installer-gui-script minSpecVersion="2">
    <title>Scope Deck</title>
    <organization>com.scopedeck</organization>
    <options customize="never" require-scripts="true" rootVolumeOnly="true" hostArchitectures="arm64,x86_64"/>
    <!-- Resolve 21 needs macOS 15; the app itself runs on 14.2 (Core Audio
         process taps), so that is the floor stated here. -->
    <volume-check>
        <allowed-os-versions>
            <os-version min="14.2"/>
        </allowed-os-versions>
    </volume-check>
    <welcome file="welcome.html" mime-type="text/html"/>
    <conclusion file="conclusion.html" mime-type="text/html"/>
    <choices-outline>
        <line choice="default">
            <line choice="com.scopedeck.pkg"/>
        </line>
    </choices-outline>
    <choice id="default"/>
    <choice id="com.scopedeck.pkg" visible="false">
        <pkg-ref id="com.scopedeck.pkg"/>
    </choice>
    <pkg-ref id="com.scopedeck.pkg" version="@VERSION@" onConclusion="none">ScopeDeck-component.pkg</pkg-ref>
</installer-gui-script>
