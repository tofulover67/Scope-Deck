#!/bin/bash
# Scope Deck's macOS installer: runs as root once the user clicks Install
# (release_mac.sh puts it in the .pkg). The payload - Scope Deck.app into
# /Applications and ScopeTap.ofx.bundle into /Library/OFX/Plugins - has
# already landed by the time this runs. This script then:
#
#   1. makes the two bundles readable by everyone, as a drag-installed app is;
#   2. switches App Nap off for DaVinci Resolve, for the person at the Mac;
#   3. sees to the Python the Timecode and Subtitle panels need. The bridges
#      run timecode_poll_worker.py / subtitle_poll_worker.py with whatever
#      app/PosixProcess.cpp's FindPythonLauncher finds: python.org's framework
#      first, then Homebrew's, then /usr/local, then Apple's /usr/bin/python3
#      when the Command Line Tools make it real. A Mac with none of those at
#      3.10 or newer gets python.org's installed here - its own installer,
#      pinned by SHA-256. Only the standard library is used, plus Resolve's
#      own scripting module, so no packages.
#
# Nothing here fails the install. The app and plugin are already in place, and
# a Mac that is offline, or behind a captive portal, or whose download is
# refused, still has a working Scope Deck - only the two Resolve-scripting
# panels want the Python, and the app says so in the panel when it is missing.
# Everything is logged to /Library/Logs/ScopeDeck-install.log.

set -u

LOG=/Library/Logs/ScopeDeck-install.log
exec >>"$LOG" 2>&1
echo "=== Scope Deck install, $(date)"

# ----------------------------------------------------------------- permissions

chmod -R a+rX "/Applications/Scope Deck.app" "/Library/OFX/Plugins/ScopeTap.ofx.bundle" 2>/dev/null || true

# ------------------------------------------------------------ Resolve App Nap

# When DaVinci Resolve's window is completely covered - easy on a one-display
# Mac with the scopes in front - macOS puts Resolve to sleep (App Nap) and its
# playback free-runs with no sound until part of its window shows again.
# NSAppSleepDisabled is Apple's per-app opt-out, the same setting Activity
# Monitor's old "Prevent App Nap" checkbox wrote. Set for the person at the
# Mac, in their own preferences, as they would from Terminal; Resolve picks it
# up on its next start. Confirmed to cure the symptom on Resolve 21. Done
# before the Python step so a slow download can never stand between the user
# and this.
USER_NAME="$(stat -f%Su /dev/console)"
if [ -n "$USER_NAME" ] && [ "$USER_NAME" != "root" ] && [ "$USER_NAME" != "loginwindow" ]; then
    if sudo -u "$USER_NAME" defaults write com.blackmagic-design.DaVinciResolve NSAppSleepDisabled -bool YES; then
        echo "App Nap disabled for DaVinci Resolve ($USER_NAME)"
    else
        echo "Could not write Resolve's App Nap preference for $USER_NAME (not fatal)"
    fi
else
    echo "No console user found - Resolve's App Nap preference left alone"
fi

# -------------------------------------------------------------------- Python

# Pinned by its SHA-256 from python.org's release page, so a tampered download
# is refused. Change both together.
PY_VERSION="3.13.15"
PY_URL="https://www.python.org/ftp/python/${PY_VERSION}/python-${PY_VERSION}-macos11.pkg"
PY_SHA256="3b7eaf7f29825f796e8267024435540ddf1f17fc9a97ad58095daa7a75bfdcd3"

# True when $1 is a Python 3.10 or newer that runs.
python_ok() {
    [ -x "$1" ] && "$1" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 10) else 1)' >/dev/null 2>&1
}

# The launchers the app itself would accept, in the app's order.
find_pythons() {
    for dir in /Library/Frameworks/Python.framework/Versions/3.*; do
        python_ok "$dir/bin/python3" && echo "$dir/bin/python3"
    done
    for p in /opt/homebrew/bin/python3 /usr/local/bin/python3; do
        python_ok "$p" && echo "$p"
    done
    # Apple's stub only becomes a Python once the Command Line Tools are in;
    # running it without them would offer to install them instead.
    if xcode-select -p >/dev/null 2>&1; then
        python_ok /usr/bin/python3 && echo /usr/bin/python3
    fi
}

PYTHONS="$(find_pythons)"
if [ -n "$PYTHONS" ]; then
    echo "Python 3.10+ already present, nothing to install:"
    echo "$PYTHONS"
else
    echo "No Python 3.10+ found - installing python.org's Python $PY_VERSION"
    WORK="$(mktemp -d 2>/dev/null)"
    if [ -z "$WORK" ]; then
        echo "WARNING: could not make a temporary directory; Python not installed"
    elif ! curl -fL --retry 3 --connect-timeout 20 --max-time 600 -o "$WORK/python.pkg" "$PY_URL"; then
        echo "WARNING: could not download $PY_URL (offline?); Python not installed."
        echo "         The Timecode and Subtitle panels need Python 3.10+ - install one from python.org later."
    else
        GOT="$(shasum -a 256 "$WORK/python.pkg" | awk '{print $1}')"
        if [ "$GOT" != "$PY_SHA256" ]; then
            echo "WARNING: Python download's checksum is wrong (got $GOT) - not installing it"
        elif ! installer -pkg "$WORK/python.pkg" -target /; then
            echo "WARNING: python.org's installer failed; Python not installed"
        else
            PYTHONS="$(find_pythons)"
            if [ -n "$PYTHONS" ]; then
                echo "Installed Python $PY_VERSION:"
                echo "$PYTHONS"
            else
                echo "WARNING: Python installed, but no Python 3.10+ found afterwards"
            fi
        fi
    fi
    [ -n "$WORK" ] && rm -rf "$WORK"
fi

echo "=== Done"
exit 0
